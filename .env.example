# ============================================================
#  JOB HUNTER BOT — configuration
#  Copy this file to .env and fill in your own values:
#     cp .env.example .env
# ============================================================

# ---- Gmail (IMAP) --------------------------------------------------
# The Gmail account that receives your LinkedIn Job Alert emails.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.email@gmail.com

# NOT your normal Gmail password. Create a Google "App Password":
#   Google Account -> Security -> 2-Step Verification -> App passwords
IMAP_PASSWORD=your-16-char-app-password

# Mailbox to read from. INBOX is fine, or a Gmail label/folder you
# route LinkedIn alerts into with a filter (recommended), e.g. "LinkedIn".
IMAP_FOLDER=INBOX

# Only look at emails from the last N days (keeps each run fast).
SEARCH_DAYS=3

# Mark processed LinkedIn emails as read? true/false
MARK_AS_READ=false

# ---- LinkedIn alert senders ---------------------------------------
# Comma-separated. These are the addresses LinkedIn sends job alerts from.
LINKEDIN_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com,jobs-listings@linkedin.com

# ---- Keyword filter -----------------------------------------------
# Comma-separated. A job is kept if its title matches ANY of these
# (case-insensitive substring match).
KEYWORDS=devops,sre,site reliability,platform engineer,cloud engineer,infrastructure engineer,infrastructure,kubernetes,terraform,cloud

# Optional: drop jobs whose title contains ANY of these words.
EXCLUDE_KEYWORDS=senior manager,director,head of,intern,sales

# ---- Telegram ------------------------------------------------------
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Your chat id. Get it from @userinfobot, or run: python main.py --chat-id
TELEGRAM_CHAT_ID=123456789
